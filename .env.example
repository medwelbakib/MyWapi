# Your WhatsApp number, digits only, with country code (no + or spaces).
PHONE_NUMBER=15551234567

# Path to Firebase service account JSON (never commit it).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firestore collection apps write requests into.
COLLECTION=wa_messages

# Max send attempts before status becomes "failed".
MAX_ATTEMPTS=3

# Delay between sends in ms (anti-ban throttle).
SEND_DELAY_MS=1500
