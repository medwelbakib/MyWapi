rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the owner may touch the queue. The MyWapi service uses the Admin SDK,
    // which bypasses rules, so it needs no rule.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'owner@example.com'
        && request.auth.token.email_verified == true;
    }

    match /wa_messages/{id} {
      allow read: if isOwner();
      // Apps may only create new pending requests with the expected shape.
      allow create: if isOwner()
        && request.resource.data.status == 'pending'
        && request.resource.data.to is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
